INCLUDES = $(HOLBADIR)/src/shared/l3-machine-code/riscv/model

all: $(DEFAULT_TARGETS)
.PHONY: all

# The selftest of riscv_stepLib (upstream's step/selftest.sml, see
# ../VENDORING.md), compiled and run as upstream does.  It takes some
# minutes, so it is not one of the tests of "make tests"; run it with
# "Holmake selftest".
riscv_step_selftest.exe: riscv_step_selftest.uo riscv_stepLib.uo
	$(HOLMOSMLC) -o $@ $<

selftest: riscv_step_selftest.exe
	./riscv_step_selftest.exe > riscv_step_selftest.log 2>&1 || { tail -40 riscv_step_selftest.log; exit 1; }
	tail -3 riscv_step_selftest.log
.PHONY: selftest

EXTRA_CLEANS = riscv_step_selftest.exe riscv_step_selftest.log
