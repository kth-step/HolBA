fun rnd_mode_static rnd =
  case rnd of
     BitsN.B(0x0,_) => Option.SOME RNE
   | BitsN.B(0x1,_) => Option.SOME RTZ
   | BitsN.B(0x2,_) => Option.SOME RDN
   | BitsN.B(0x3,_) => Option.SOME RUP
   | BitsN.B(0x4,_) => Option.SOME RMM
   | BitsN.B(0x7,_) => Option.SOME RDYN
   | _ => NONE;

fun rnd_mode_dynamic rnd =
  case rnd of
     BitsN.B(0x0,_) => Option.SOME RNE
   | BitsN.B(0x1,_) => Option.SOME RTZ
   | BitsN.B(0x2,_) => Option.SOME RDN
   | BitsN.B(0x3,_) => Option.SOME RUP
   | BitsN.B(0x4,_) => Option.SOME RMM
   | _ => NONE;

fun l3round rnd =
  case rnd of
     RNE => Option.SOME IEEEReal.TO_NEAREST
   | RTZ => Option.SOME IEEEReal.TO_ZERO
   | RDN => Option.SOME IEEEReal.TO_NEGINF
   | RUP => Option.SOME IEEEReal.TO_POSINF
   | RMM => NONE
   | RDYN => NONE;

fun round rnd =
  case rnd_mode_static rnd of
     Option.SOME RDYN =>
       (case rnd_mode_dynamic(#FRM((fcsr ()) : FPCSR)) of
           Option.SOME frm => l3round frm
         | NONE => NONE)
   | Option.SOME frm => l3round frm
   | NONE => NONE;

fun validRounding rnd =
  case rnd_mode_static rnd of
     Option.SOME RDYN =>
       Option.isSome(rnd_mode_dynamic(#FRM((fcsr ()) : FPCSR)))
   | Option.SOME _ => true
   | NONE => false;

val RV32_CanonicalNan = BitsN.B(0x7FC00000,32)

val RV64_CanonicalNan = BitsN.B(0x7FF8000000000000,64)

fun canonS x = if FP32.isNan x then RV32_CanonicalNan else x;

fun canonD x = if FP64.isNan x then RV64_CanonicalNan else x;

fun FP32_IsSignalingNan x =
  ((BitsN.bits(30,23) x) = (BitsN.B(0xFF,8))) andalso
  (((BitsN.bit(x,22)) = false) andalso
   (not((BitsN.bits(21,0) x) = (BitsN.B(0x0,22)))));

fun FP64_IsSignalingNan x =
  ((BitsN.bits(62,52) x) = (BitsN.B(0x7FF,11))) andalso
  (((BitsN.bit(x,51)) = false) andalso
   (not((BitsN.bits(50,0) x) = (BitsN.B(0x0,51)))));

fun FP32_Sign x = BitsN.bit(x,31);

fun FP64_Sign x = BitsN.bit(x,63);

fun FP32_InfTimesZero (a,b) =
  ((FP32.isZero a) andalso ((b = FP32.posInf) orelse (b = FP32.negInf))) orelse
  ((FP32.isZero b) andalso ((a = FP32.posInf) orelse (a = FP32.negInf)));

fun FP64_InfTimesZero (a,b) =
  ((FP64.isZero a) andalso ((b = FP64.posInf) orelse (b = FP64.negInf))) orelse
  ((FP64.isZero b) andalso ((a = FP64.posInf) orelse (a = FP64.negInf)));

fun setFP_Invalid () =
  let val x = fcsr () in write'fcsr(FPCSR_NV_rupd(x,true)) end;

fun setFP_DivZero () =
  let val x = fcsr () in write'fcsr(FPCSR_DZ_rupd(x,true)) end;

fun setFP_Overflow () =
  let val x = fcsr () in write'fcsr(FPCSR_OF_rupd(x,true)) end;

fun setFP_Underflow () =
  let val x = fcsr () in write'fcsr(FPCSR_UF_rupd(x,true)) end;

fun setFP_Inexact () =
  let val x = fcsr () in write'fcsr(FPCSR_NX_rupd(x,true)) end;

fun accrueFlags f =
  ( if #InvalidOp(f : SSE.ieee_flags) then setFP_Invalid () else ()
  ; if #DivideByZero(f : SSE.ieee_flags) then setFP_DivZero () else ()
  ; if #Overflow(f : SSE.ieee_flags) then setFP_Overflow () else ()
  ; if #Underflow(f : SSE.ieee_flags) then setFP_Underflow () else ()
  ; if #Precision(f : SSE.ieee_flags) then setFP_Inexact () else ()
  );

fun csrRW csr = BitsN.bits(11,10) csr;

fun csrPR csr = BitsN.bits(9,8) csr;

fun check_CSR_access (rw,(pr,(p,a))) =
  ((a = Read) orelse (not(rw = (BitsN.B(0x3,2))))) andalso
  (BitsN.>=+(privLevel p,pr));

fun is_CSR_defined csr =
  ((BitsN.>=+(csr,BitsN.B(0x1,12))) andalso
   (BitsN.<=+(csr,BitsN.B(0x3,12)))) orelse
  (((BitsN.>=+(csr,BitsN.B(0xC00,12))) andalso
    (BitsN.<=+(csr,BitsN.B(0xC02,12)))) orelse
   ((csr = (BitsN.B(0x100,12))) orelse
    (((BitsN.>=+(csr,BitsN.B(0x104,12))) andalso
      (BitsN.<=+(csr,BitsN.B(0x106,12)))) orelse
     ((csr = (BitsN.B(0x10A,12))) orelse
      (((BitsN.>=+(csr,BitsN.B(0x140,12))) andalso
        (BitsN.<=+(csr,BitsN.B(0x144,12)))) orelse
       ((csr = (BitsN.B(0x180,12))) orelse
        (((BitsN.>=+(csr,BitsN.B(0xF11,12))) andalso
          (BitsN.<=+(csr,BitsN.B(0xF15,12)))) orelse
         (((BitsN.>=+(csr,BitsN.B(0x300,12))) andalso
           (BitsN.<=+(csr,BitsN.B(0x306,12)))) orelse
          ((csr = (BitsN.B(0x30A,12))) orelse
           ((csr = (BitsN.B(0x320,12))) orelse
            (((BitsN.>=+(csr,BitsN.B(0x323,12))) andalso
              (BitsN.<=+(csr,BitsN.B(0x33F,12)))) orelse
             (((BitsN.>=+(csr,BitsN.B(0x340,12))) andalso
               (BitsN.<=+(csr,BitsN.B(0x344,12)))) orelse
              ((csr = (BitsN.B(0x3A0,12))) orelse
               ((csr = (BitsN.B(0x3A2,12))) orelse
                (((BitsN.>=+(csr,BitsN.B(0x3B0,12))) andalso
                  (BitsN.<=+(csr,BitsN.B(0x3BF,12)))) orelse
                 ((csr = (BitsN.B(0xB00,12))) orelse
                  ((BitsN.>=+(csr,BitsN.B(0xB02,12))) andalso
                   (BitsN.<=+(csr,BitsN.B(0xB1F,12))))))))))))))))))));

fun is_mhpm_CSR csr =
  ((BitsN.>=+(csr,BitsN.B(0x323,12))) andalso
   (BitsN.<=+(csr,BitsN.B(0x33F,12)))) orelse
  ((BitsN.>=+(csr,BitsN.B(0xB03,12))) andalso
   (BitsN.<=+(csr,BitsN.B(0xB1F,12))));

fun check_CSR_conditions (csr,p) =
  if (BitsN.>=+(csr,BitsN.B(0x1,12))) andalso
     (BitsN.<=+(csr,BitsN.B(0x3,12)))
    then fpEnabled ()
  else if (BitsN.>=+(csr,BitsN.B(0xC00,12))) andalso
     (BitsN.<=+(csr,BitsN.B(0xC02,12)))
    then counterReadAllowed(csr,p)
  else if csr = (BitsN.B(0x180,12))
    then not((p = Supervisor) andalso
             (#TVM((#mstatus((MCSR ()) : MachineCSR)) : mstatus)))
  else true;

fun CSRMap csr =
  case csr of
     BitsN.B(0x1,_) =>
       BitsN.zeroExtend 64
         (BitsN.bits(4,0)
            (reg'FPCSR
               (#fpcsr
                  ((Map.lookup((!c_UCSR),BitsN.toNat (!procID))) : UserCSR))))
   | BitsN.B(0x2,_) =>
     BitsN.zeroExtend 64
       (#FRM
          ((#fpcsr
              ((Map.lookup((!c_UCSR),BitsN.toNat (!procID))) : UserCSR)) :
           FPCSR))
   | BitsN.B(0x3,_) =>
     BitsN.zeroExtend 64
       (BitsN.bits(7,0)
          (reg'FPCSR
             (#fpcsr
                ((Map.lookup((!c_UCSR),BitsN.toNat (!procID))) : UserCSR))))
   | BitsN.B(0xC00,_) => Map.lookup((!c_cycles),BitsN.toNat (!procID))
   | BitsN.B(0xC01,_) => mtime ()
   | BitsN.B(0xC02,_) => Map.lookup((!c_instret),BitsN.toNat (!procID))
   | BitsN.B(0x100,_) =>
     read_sstatus
       (#mstatus
          ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR))
   | BitsN.B(0x104,_) =>
     BitsN.&&
       (reg'mie
          (#mie
             ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)),
        #mideleg
          ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR))
   | BitsN.B(0x105,_) =>
     #stvec((Map.lookup((!c_SCSR),BitsN.toNat (!procID))) : SupervisorCSR)
   | BitsN.B(0x106,_) =>
     #scounteren
       ((Map.lookup((!c_SCSR),BitsN.toNat (!procID))) : SupervisorCSR)
   | BitsN.B(0x10A,_) =>
     #senvcfg
       ((Map.lookup((!c_SCSR),BitsN.toNat (!procID))) : SupervisorCSR)
   | BitsN.B(0x140,_) =>
     #sscratch
       ((Map.lookup((!c_SCSR),BitsN.toNat (!procID))) : SupervisorCSR)
   | BitsN.B(0x141,_) =>
     read_xepc
       (#sepc
          ((Map.lookup((!c_SCSR),BitsN.toNat (!procID))) : SupervisorCSR))
   | BitsN.B(0x142,_) =>
     reg'mcause
       (#scause
          ((Map.lookup((!c_SCSR),BitsN.toNat (!procID))) : SupervisorCSR))
   | BitsN.B(0x143,_) =>
     #stval((Map.lookup((!c_SCSR),BitsN.toNat (!procID))) : SupervisorCSR)
   | BitsN.B(0x144,_) =>
     BitsN.&&
       (read_mip (),
        #mideleg
          ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR))
   | BitsN.B(0x180,_) =>
     #satp((Map.lookup((!c_SCSR),BitsN.toNat (!procID))) : SupervisorCSR)
   | BitsN.B(0xF11,_) => BitsN.B(0x0,64)
   | BitsN.B(0xF12,_) => BitsN.B(0x0,64)
   | BitsN.B(0xF13,_) => BitsN.B(0x0,64)
   | BitsN.B(0xF14,_) =>
     #mhartid((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0xF15,_) => BitsN.B(0x0,64)
   | BitsN.B(0x300,_) =>
     read_mstatus
       (#mstatus
          ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR))
   | BitsN.B(0x301,_) =>
     reg'misa
       (#misa((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR))
   | BitsN.B(0x302,_) =>
     #medeleg((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x303,_) =>
     #mideleg((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x304,_) =>
     reg'mie
       (#mie((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR))
   | BitsN.B(0x305,_) =>
     #mtvec((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x306,_) =>
     #mcounteren
       ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x30A,_) =>
     #menvcfg((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x320,_) =>
     #mcountinhibit
       ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x340,_) =>
     #mscratch((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x341,_) =>
     read_xepc
       (#mepc((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR))
   | BitsN.B(0x342,_) =>
     reg'mcause
       (#mcause
          ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR))
   | BitsN.B(0x343,_) =>
     #mtval((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x344,_) => read_mip ()
   | BitsN.B(0x3A0,_) =>
     #pmpcfg0((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x3A2,_) =>
     #pmpcfg2((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x3B0,_) =>
     #pmpaddr0((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x3B1,_) =>
     #pmpaddr1((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x3B2,_) =>
     #pmpaddr2((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x3B3,_) =>
     #pmpaddr3((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x3B4,_) =>
     #pmpaddr4((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x3B5,_) =>
     #pmpaddr5((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x3B6,_) =>
     #pmpaddr6((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x3B7,_) =>
     #pmpaddr7((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x3B8,_) =>
     #pmpaddr8((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x3B9,_) =>
     #pmpaddr9((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x3BA,_) =>
     #pmpaddr10
       ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x3BB,_) =>
     #pmpaddr11
       ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x3BC,_) =>
     #pmpaddr12
       ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x3BD,_) =>
     #pmpaddr13
       ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x3BE,_) =>
     #pmpaddr14
       ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0x3BF,_) =>
     #pmpaddr15
       ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR)
   | BitsN.B(0xB00,_) => Map.lookup((!c_cycles),BitsN.toNat (!procID))
   | BitsN.B(0xB02,_) => Map.lookup((!c_instret),BitsN.toNat (!procID))
   | _ =>
     (if is_mhpm_CSR csr
        then BitsN.B(0x0,64)
      else raise UNDEFINED
             ("unexpected CSR read at " ^ (BitsN.toHexString csr)));

fun write'CSRMap (value,csr) =
  case csr of
     BitsN.B(0x1,_) =>
       ( let
           val x0 = Map.lookup((!c_UCSR),BitsN.toNat (!procID))
           val x1 = #fpcsr(x0 : UserCSR)
           val w = reg'FPCSR x1
         in
           c_UCSR :=
           (Map.update
              ((!c_UCSR),BitsN.toNat (!procID),
               UserCSR_fpcsr_rupd
                 (x0,
                  write'reg'FPCSR
                    (x1,
                     BitsN.bitFieldInsert(4,0) (w,BitsN.bits(4,0) value)))))
         end
       ; let
           val x0 = Map.lookup((!c_MCSR),BitsN.toNat (!procID))
           val x1 = #mstatus(x0 : MachineCSR)
         in
           c_MCSR :=
           (Map.update
              ((!c_MCSR),BitsN.toNat (!procID),
               MachineCSR_mstatus_rupd
                 (x0,mstatus_FS_rupd(x1,ext_status Dirty))))
         end
       )
   | BitsN.B(0x2,_) =>
     ( let
         val x0 = Map.lookup((!c_UCSR),BitsN.toNat (!procID))
         val x1 = #fpcsr(x0 : UserCSR)
       in
         c_UCSR :=
         (Map.update
            ((!c_UCSR),BitsN.toNat (!procID),
             UserCSR_fpcsr_rupd
               (x0,FPCSR_FRM_rupd(x1,BitsN.bits(2,0) value))))
       end
     ; let
         val x0 = Map.lookup((!c_MCSR),BitsN.toNat (!procID))
         val x1 = #mstatus(x0 : MachineCSR)
       in
         c_MCSR :=
         (Map.update
            ((!c_MCSR),BitsN.toNat (!procID),
             MachineCSR_mstatus_rupd
               (x0,mstatus_FS_rupd(x1,ext_status Dirty))))
       end
     )
   | BitsN.B(0x3,_) =>
     ( let
         val x0 = Map.lookup((!c_UCSR),BitsN.toNat (!procID))
         val x1 = #fpcsr(x0 : UserCSR)
       in
         c_UCSR :=
         (Map.update
            ((!c_UCSR),BitsN.toNat (!procID),
             UserCSR_fpcsr_rupd
               (x0,
                write'reg'FPCSR
                  (x1,BitsN.zeroExtend 32 (BitsN.bits(7,0) value)))))
       end
     ; let
         val x0 = Map.lookup((!c_MCSR),BitsN.toNat (!procID))
         val x1 = #mstatus(x0 : MachineCSR)
       in
         c_MCSR :=
         (Map.update
            ((!c_MCSR),BitsN.toNat (!procID),
             MachineCSR_mstatus_rupd
               (x0,mstatus_FS_rupd(x1,ext_status Dirty))))
       end
     )
   | BitsN.B(0x100,_) =>
     let
       val x0 = Map.lookup((!c_MCSR),BitsN.toNat (!procID))
     in
       c_MCSR :=
       (Map.update
          ((!c_MCSR),BitsN.toNat (!procID),
           MachineCSR_mstatus_rupd
             (x0,
              legalize_sstatus
                (value,
                 #mstatus
                   ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) :
                    MachineCSR)))))
     end
   | BitsN.B(0x104,_) =>
     let
       val x0 = Map.lookup((!c_MCSR),BitsN.toNat (!procID))
     in
       c_MCSR :=
       (Map.update
          ((!c_MCSR),BitsN.toNat (!procID),
           MachineCSR_mie_rupd
             (x0,
              rec'mie
                (BitsN.||
                   (BitsN.&&
                      (reg'mie
                         (#mie
                            ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) :
                             MachineCSR)),
                       BitsN.~
                         (#mideleg
                            ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) :
                             MachineCSR))),
                    BitsN.&&
                      (value,
                       #mideleg
                         ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) :
                          MachineCSR)))))))
     end
   | BitsN.B(0x105,_) =>
     let
       val x0 = Map.lookup((!c_SCSR),BitsN.toNat (!procID))
     in
       c_SCSR :=
       (Map.update
          ((!c_SCSR),BitsN.toNat (!procID),
           SupervisorCSR_stvec_rupd
             (x0,
              legalize_xtvec
                (value,
                 #stvec
                   ((Map.lookup((!c_SCSR),BitsN.toNat (!procID))) :
                    SupervisorCSR)))))
     end
   | BitsN.B(0x106,_) =>
     let
       val x0 = Map.lookup((!c_SCSR),BitsN.toNat (!procID))
     in
       c_SCSR :=
       (Map.update
          ((!c_SCSR),BitsN.toNat (!procID),
           SupervisorCSR_scounteren_rupd
             (x0,BitsN.&&(value,BitsN.B(0x7,64)))))
     end
   | BitsN.B(0x10A,_) =>
     let
       val x0 = Map.lookup((!c_SCSR),BitsN.toNat (!procID))
     in
       c_SCSR :=
       (Map.update
          ((!c_SCSR),BitsN.toNat (!procID),
           SupervisorCSR_senvcfg_rupd(x0,BitsN.&&(value,BitsN.B(0x1,64)))))
     end
   | BitsN.B(0x140,_) =>
     let
       val x0 = Map.lookup((!c_SCSR),BitsN.toNat (!procID))
     in
       c_SCSR :=
       (Map.update
          ((!c_SCSR),BitsN.toNat (!procID),
           SupervisorCSR_sscratch_rupd(x0,value)))
     end
   | BitsN.B(0x141,_) =>
     let
       val x0 = Map.lookup((!c_SCSR),BitsN.toNat (!procID))
     in
       c_SCSR :=
       (Map.update
          ((!c_SCSR),BitsN.toNat (!procID),
           SupervisorCSR_sepc_rupd(x0,legalize_xepc value)))
     end
   | BitsN.B(0x142,_) =>
     let
       val x0 = Map.lookup((!c_SCSR),BitsN.toNat (!procID))
     in
       c_SCSR :=
       (Map.update
          ((!c_SCSR),BitsN.toNat (!procID),
           SupervisorCSR_scause_rupd
             (x0,
              legalize_scause
                (value,
                 #scause
                   ((Map.lookup((!c_SCSR),BitsN.toNat (!procID))) :
                    SupervisorCSR)))))
     end
   | BitsN.B(0x143,_) =>
     let
       val x0 = Map.lookup((!c_SCSR),BitsN.toNat (!procID))
     in
       c_SCSR :=
       (Map.update
          ((!c_SCSR),BitsN.toNat (!procID),
           SupervisorCSR_stval_rupd(x0,value)))
     end
   | BitsN.B(0x144,_) =>
     if BitsN.bit
          (#mideleg
             ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) : MachineCSR),
           1)
       then let
              val x0 = Map.lookup((!c_MCSR),BitsN.toNat (!procID))
              val x1 = #mip(x0 : MachineCSR)
            in
              c_MCSR :=
              (Map.update
                 ((!c_MCSR),BitsN.toNat (!procID),
                  MachineCSR_mip_rupd
                    (x0,mip_SSIP_rupd(x1,BitsN.bit(value,1)))))
            end
     else ()
   | BitsN.B(0x180,_) =>
     let
       val x0 = Map.lookup((!c_SCSR),BitsN.toNat (!procID))
     in
       c_SCSR :=
       (Map.update
          ((!c_SCSR),BitsN.toNat (!procID),
           SupervisorCSR_satp_rupd
             (x0,
              legalize_satp
                (value,
                 #satp
                   ((Map.lookup((!c_SCSR),BitsN.toNat (!procID))) :
                    SupervisorCSR)))))
     end
   | BitsN.B(0x300,_) =>
     let
       val x0 = Map.lookup((!c_MCSR),BitsN.toNat (!procID))
     in
       c_MCSR :=
       (Map.update
          ((!c_MCSR),BitsN.toNat (!procID),
           MachineCSR_mstatus_rupd(x0,legalize_mstatus value)))
     end
   | BitsN.B(0x301,_) =>
     let
       val x0 = Map.lookup((!c_MCSR),BitsN.toNat (!procID))
     in
       c_MCSR :=
       (Map.update
          ((!c_MCSR),BitsN.toNat (!procID),
           MachineCSR_misa_rupd
             (x0,
              legalize_misa
                (value,
                 (#misa
                    ((Map.lookup((!c_MCSR),BitsN.toNat (!procID))) :
                     MachineCSR),Map.lookup((!c_PC),BitsN.toNat (!procID)))))))
     end
   | BitsN.B(0x302,_) =>
     let
       val x0 = Map.lookup((!c_MCSR),BitsN.toNat (!procID))
     in
       c_MCSR :=
       (Map.update
          ((!c_MCSR),BitsN.toNat (!procID),
           MachineCSR_medeleg_rupd(x0,BitsN.&&(value,BitsN.B(0xB3FF,64)))))
     end
   | BitsN.B(0x303,_) =>
     let
       val x0 = Map.lookup((!c_MCSR),BitsN.toNat (!procID))
     in
       c_MCSR :=
       (Map.update
          ((!c_MCSR),BitsN.toNat (!procID),
           MachineCSR_mideleg_rupd(x0,BitsN.&&(value,BitsN.B(0x222,64)))))
     end
   | BitsN.B(0x304,_) =>
     let
       val x0 = Map.lookup((!c_MCSR),BitsN.toNat (!procID))
     in
       c_MCSR :=
       (Map.update
          ((!c_MCSR),BitsN.toNat (!procID),
           MachineCSR_mie_rupd
