      else ());

fun csrName csr =
  case csr of
     BitsN.B(0x1,_) => "fflags"
   | BitsN.B(0x2,_) => "frm"
   | BitsN.B(0x3,_) => "fcsr"
   | BitsN.B(0xC00,_) => "cycle"
   | BitsN.B(0xC01,_) => "time"
   | BitsN.B(0xC02,_) => "instret"
   | BitsN.B(0x100,_) => "sstatus"
   | BitsN.B(0x104,_) => "sie"
   | BitsN.B(0x105,_) => "stvec"
   | BitsN.B(0x106,_) => "scounteren"
   | BitsN.B(0x10A,_) => "senvcfg"
   | BitsN.B(0x140,_) => "sscratch"
   | BitsN.B(0x141,_) => "sepc"
   | BitsN.B(0x142,_) => "scause"
   | BitsN.B(0x143,_) => "stval"
   | BitsN.B(0x144,_) => "sip"
   | BitsN.B(0x180,_) => "satp"
   | BitsN.B(0xF11,_) => "mvendorid"
   | BitsN.B(0xF12,_) => "marchid"
   | BitsN.B(0xF13,_) => "mimpid"
   | BitsN.B(0xF14,_) => "mhartid"
   | BitsN.B(0xF15,_) => "mconfigptr"
   | BitsN.B(0x300,_) => "mstatus"
   | BitsN.B(0x301,_) => "misa"
   | BitsN.B(0x302,_) => "medeleg"
   | BitsN.B(0x303,_) => "mideleg"
   | BitsN.B(0x304,_) => "mie"
   | BitsN.B(0x305,_) => "mtvec"
   | BitsN.B(0x306,_) => "mcounteren"
   | BitsN.B(0x30A,_) => "menvcfg"
   | BitsN.B(0x320,_) => "mcountinhibit"
   | BitsN.B(0x340,_) => "mscratch"
   | BitsN.B(0x341,_) => "mepc"
   | BitsN.B(0x342,_) => "mcause"
   | BitsN.B(0x343,_) => "mtval"
   | BitsN.B(0x344,_) => "mip"
   | BitsN.B(0x3A0,_) => "pmpcfg0"
   | BitsN.B(0x3A2,_) => "pmpcfg2"
   | BitsN.B(0xB00,_) => "mcycle"
   | BitsN.B(0xB02,_) => "minstret"
   | _ =>
     (if (BitsN.>=+(csr,BitsN.B(0x3B0,12))) andalso
         (BitsN.<=+(csr,BitsN.B(0x3BF,12)))
        then "pmpaddr" ^ (Nat.toString(BitsN.toNat(BitsN.bits(3,0) csr)))
      else if (BitsN.>=+(csr,BitsN.B(0x323,12))) andalso
         (BitsN.<=+(csr,BitsN.B(0x33F,12)))
        then "mhpmevent"
               ^
               (Nat.toString(BitsN.toNat(BitsN.bits(4,0) csr)))
      else if (BitsN.>=+(csr,BitsN.B(0xB03,12))) andalso
         (BitsN.<=+(csr,BitsN.B(0xB1F,12)))
        then "mhpmcounter"
               ^
               (Nat.toString(BitsN.toNat(BitsN.bits(4,0) csr)))
      else "0x" ^ (L3.padLeftString(#"0",(3,BitsN.toHexString csr))));

