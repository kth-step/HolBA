fun clear_logs () = log := [];

fun setTrap (e,tval) =
  let
    val trap = ref {trap = Breakpoint, tval = BitsN.B(0x0,64)}
  in
    ( trap := (SynchronousTrap_trap_rupd((!trap),e))
    ; trap := (SynchronousTrap_tval_rupd((!trap),tval))
    ; write'NextFetch(Option.SOME(Trap (!trap)))
    )
  end;

fun signalException e =
  ( log := ((1,"signalling exception " ^ (excName e)) :: (!log))
  ; setTrap(e,BitsN.B(0x0,64))
  ; let
      val x = Delta ()
    in
      write'Delta(StateDelta_exc_taken_rupd(x,true))
    end
  );

fun signalAddressException (e,vAddr) =
  ( log :=
    ((1,
      String.concat
        ["signalling address exception ",excName e," at ",
         BitsN.toHexString vAddr])
       ::
       (!log))
  ; setTrap(e,vAddr)
  ; let
      val x = Delta ()
    in
      write'Delta(StateDelta_exc_taken_rupd(x,true))
    end
  );

fun signalEnvCall () =
  let
    val e =
      case curPrivilege () of
         User => UMode_Env_Call
       | Supervisor => SMode_Env_Call
       | Machine => MMode_Env_Call
  in
    signalException e
  end;

fun excDest (ec,p) =
  if (not(p = Machine)) andalso
     (BitsN.bit(#medeleg((MCSR ()) : MachineCSR),BitsN.toNat ec))
    then Supervisor
  else Machine;

fun highestInterrupt p =
  if BitsN.bit(p,11)
    then Option.SOME MEI
  else if BitsN.bit(p,3)
    then Option.SOME MSI
  else if BitsN.bit(p,7)
    then Option.SOME MTI
  else if BitsN.bit(p,9)
    then Option.SOME SEI
  else if BitsN.bit(p,1)
    then Option.SOME SSI
  else if BitsN.bit(p,5) then Option.SOME STI else NONE;

fun checkInterrupts () =
  let
    val p = curPrivilege ()
    val pend = BitsN.&&(read_mip (),reg'mie(#mie((MCSR ()) : MachineCSR)))
    val m =
      if (not(p = Machine)) orelse
         (#MIE((#mstatus((MCSR ()) : MachineCSR)) : mstatus))
        then highestInterrupt
               (BitsN.&&(pend,BitsN.~(#mideleg((MCSR ()) : MachineCSR))))
      else NONE
    val s =
      if (p = User) orelse
         ((p = Supervisor) andalso
          (#SIE((#mstatus((MCSR ()) : MachineCSR)) : mstatus)))
        then highestInterrupt
               (BitsN.&&(pend,#mideleg((MCSR ()) : MachineCSR)))
      else NONE
  in
    case (m,s) of
       (Option.SOME i,_) => Option.SOME(i,Machine)
     | (NONE,Option.SOME i) => Option.SOME(i,Supervisor)
     | (NONE,NONE) => NONE
  end;

fun trapVector (tvec,(intr,ec)) =
  let
    val base = BitsN.@@(BitsN.bits(63,2) tvec,BitsN.B(0x0,2))
  in
    if intr andalso ((BitsN.bits(1,0) tvec) = (BitsN.B(0x1,2)))
      then BitsN.+(base,BitsN.*(BitsN.B(0x4,64),BitsN.zeroExtend 64 ec))
    else base
  end;

fun takeTrap (intr,(ec,(epc,(tval,toPriv)))) =
  let
    val fromP = curPrivilege ()
  in
    ( log :=
      ((1,
        String.concat
          ["trapping from ",privName fromP," to ",privName toPriv,
           " at pc ",BitsN.toHexString epc,
           if intr then " [intr] " else " [exc] ",
           Nat.toString(BitsN.toNat ec)])
         ::
         (!log))
    ; case toPriv of
         User => raise INTERNAL_ERROR "Illegal trap to U-mode"
       | Supervisor =>
         ( let
             val x = SCSR ()
             val x0 = #scause(x : SupervisorCSR)
           in
             write'SCSR
               (SupervisorCSR_scause_rupd(x,mcause_Int_rupd(x0,intr)))
           end
         ; let
             val x = SCSR ()
             val x0 = #scause(x : SupervisorCSR)
           in
             write'SCSR
               (SupervisorCSR_scause_rupd
                  (x,mcause_EC_rupd(x0,BitsN.zeroExtend 63 ec)))
           end
         ; let
             val x = SCSR ()
           in
             write'SCSR(SupervisorCSR_sepc_rupd(x,epc))
           end
         ; let
             val x = SCSR ()
           in
             write'SCSR(SupervisorCSR_stval_rupd(x,tval))
           end
         ; let
             val x = MCSR ()
             val x0 = #mstatus(x : MachineCSR)
           in
             write'MCSR
               (MachineCSR_mstatus_rupd
                  (x,
                   mstatus_SPIE_rupd
                     (x0,
                      #SIE((#mstatus((MCSR ()) : MachineCSR)) : mstatus))))
           end
         ; let
             val x = MCSR ()
             val x0 = #mstatus(x : MachineCSR)
           in
             write'MCSR
               (MachineCSR_mstatus_rupd(x,mstatus_SIE_rupd(x0,false)))
           end
         ; let
             val x = MCSR ()
             val x0 = #mstatus(x : MachineCSR)
           in
             write'MCSR
               (MachineCSR_mstatus_rupd
                  (x,mstatus_SPP_rupd(x0,not(fromP = User))))
           end
         ; setPrivilege Supervisor
         ; write'PC
             (trapVector(#stvec((SCSR ()) : SupervisorCSR),(intr,ec)))
         )
       | Machine =>
         ( let
             val x = MCSR ()
             val x0 = #mcause(x : MachineCSR)
           in
             write'MCSR
               (MachineCSR_mcause_rupd(x,mcause_Int_rupd(x0,intr)))
           end
         ; let
             val x = MCSR ()
             val x0 = #mcause(x : MachineCSR)
           in
             write'MCSR
               (MachineCSR_mcause_rupd
                  (x,mcause_EC_rupd(x0,BitsN.zeroExtend 63 ec)))
           end
         ; let
             val x = MCSR ()
           in
             write'MCSR(MachineCSR_mepc_rupd(x,epc))
           end
         ; let
             val x = MCSR ()
           in
             write'MCSR(MachineCSR_mtval_rupd(x,tval))
           end
         ; let
             val x = MCSR ()
             val x0 = #mstatus(x : MachineCSR)
           in
             write'MCSR
               (MachineCSR_mstatus_rupd
                  (x,
                   mstatus_MPIE_rupd
                     (x0,
