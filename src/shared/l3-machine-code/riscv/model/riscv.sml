     CSR_Write => 0 | CSR_Set => 1 | CSR_Clear => 2

fun accessTypeToString x =
  case x of
     Read => "Read" | Write => "Write"

fun fetchTypeToString x =
  case x of
     Instruction => "Instruction" | Data => "Data"

fun ArchitectureToString x =
  case x of
     RV32I => "RV32I" | RV64I => "RV64I" | RV128I => "RV128I"

fun PrivilegeToString x =
  case x of
     User => "User" | Supervisor => "Supervisor" | Machine => "Machine"

fun ExtStatusToString x =
  case x of
     Off => "Off"
   | Initial => "Initial"
   | Clean => "Clean"
   | Dirty => "Dirty"

fun InterruptToString x =
  case x of
     SSI => "SSI"
   | MSI => "MSI"
   | STI => "STI"
   | MTI => "MTI"
   | SEI => "SEI"
   | MEI => "MEI"

fun ExceptionTypeToString x =
  case x of
     Fetch_Misaligned => "Fetch_Misaligned"
   | Fetch_Fault => "Fetch_Fault"
   | Illegal_Instr => "Illegal_Instr"
   | Breakpoint => "Breakpoint"
   | Load_Misaligned => "Load_Misaligned"
   | Load_Fault => "Load_Fault"
   | Store_AMO_Misaligned => "Store_AMO_Misaligned"
   | Store_AMO_Fault => "Store_AMO_Fault"
   | UMode_Env_Call => "UMode_Env_Call"
   | SMode_Env_Call => "SMode_Env_Call"
   | MMode_Env_Call => "MMode_Env_Call"
   | Fetch_PageFault => "Fetch_PageFault"
   | Load_PageFault => "Load_PageFault"
   | Store_AMO_PageFault => "Store_AMO_PageFault"

fun RoundingToString x =
  case x of
     RNE => "RNE"
   | RTZ => "RTZ"
   | RDN => "RDN"
   | RUP => "RUP"
   | RMM => "RMM"
   | RDYN => "RDYN"

fun pmpAccessToString x =
  case x of
     PMP_Read => "PMP_Read"
   | PMP_Write => "PMP_Write"
   | PMP_ReadWrite => "PMP_ReadWrite"
   | PMP_Execute => "PMP_Execute"

fun csrOpToString x =
  case x of
     CSR_Write => "CSR_Write"
   | CSR_Set => "CSR_Set"
   | CSR_Clear => "CSR_Clear"

