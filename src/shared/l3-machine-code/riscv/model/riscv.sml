fun dfn'FCLASS_S (rd,rs) =
  if not(fpEnabled ())
    then signalException Illegal_Instr
  else let
         val ret = ref (BitsN.B(0x0,10))
       in
         let
           val val' = FPRS rs
         in
           ( ret :=
             (BitsN.bitFieldInsert(0,0)
                ((!ret),BitsN.fromBit(val' = FP32.negInf)))
           ; ret :=
             (BitsN.bitFieldInsert(1,1)
                ((!ret),
                 BitsN.fromBit
                   ((FP32_Sign val') andalso (FP32.isNormal val'))))
           ; ret :=
             (BitsN.bitFieldInsert(2,2)
                ((!ret),
                 BitsN.fromBit
                   ((FP32_Sign val') andalso (FP32.isSubnormal val'))))
           ; ret :=
             (BitsN.bitFieldInsert(3,3)
                ((!ret),BitsN.fromBit(val' = FP32.negZero)))
           ; ret :=
             (BitsN.bitFieldInsert(4,4)
                ((!ret),BitsN.fromBit(val' = FP32.posZero)))
           ; ret :=
             (BitsN.bitFieldInsert(5,5)
                ((!ret),
                 BitsN.fromBit
