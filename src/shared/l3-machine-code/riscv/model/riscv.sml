val BYTE = BitsN.B(0x0,3)

val HALFWORD = BitsN.B(0x1,3)

val WORD = BitsN.B(0x3,3)

val DOUBLEWORD = BitsN.B(0x7,3)

fun archBase a =
  case a of
     RV32I => BitsN.B(0x1,2)
   | RV64I => BitsN.B(0x2,2)
   | RV128I => BitsN.B(0x3,2);

fun architecture ab =
  case ab of
     BitsN.B(0x1,_) => RV32I
   | BitsN.B(0x2,_) => RV64I
   | BitsN.B(0x3,_) => RV128I
   | _ =>
     raise UNDEFINED
       ("Unknown architecture: " ^ (Nat.toString(BitsN.toNat ab)));

fun archName a =
  case a of RV32I => "RV32I" | RV64I => "RV64I" | RV128I => "RV128I";

fun privLevel p =
  case p of
     User => BitsN.B(0x0,2)
   | Supervisor => BitsN.B(0x1,2)
   | Machine => BitsN.B(0x3,2);

fun privilege p =
  case p of
     BitsN.B(0x1,_) => Supervisor
   | BitsN.B(0x3,_) => Machine
   | _ => User;

fun privName p =
  case p of User => "U" | Supervisor => "S" | Machine => "M";

fun ext_status e =
  case e of
     Off => BitsN.B(0x0,2)
   | Initial => BitsN.B(0x1,2)
   | Clean => BitsN.B(0x2,2)
   | Dirty => BitsN.B(0x3,2);

fun extStatus e =
  case e of
     BitsN.B(0x0,_) => Off
   | BitsN.B(0x1,_) => Initial
   | BitsN.B(0x2,_) => Clean
   | BitsN.B(0x3,_) => Dirty
   | _ => raise General.Bind;

fun extStatusName e =
  case e of
     Off => "Off"
   | Initial => "Initial"
   | Clean => "Clean"
   | Dirty => "Dirty";

fun interruptIndex i =
  case i of
     SSI => BitsN.B(0x1,4)
   | MSI => BitsN.B(0x3,4)
   | STI => BitsN.B(0x5,4)
   | MTI => BitsN.B(0x7,4)
   | SEI => BitsN.B(0x9,4)
   | MEI => BitsN.B(0xB,4);

fun excCode e =
  case e of
     Fetch_Misaligned => BitsN.B(0x0,4)
   | Fetch_Fault => BitsN.B(0x1,4)
   | Illegal_Instr => BitsN.B(0x2,4)
   | Breakpoint => BitsN.B(0x3,4)
   | Load_Misaligned => BitsN.B(0x4,4)
   | Load_Fault => BitsN.B(0x5,4)
   | Store_AMO_Misaligned => BitsN.B(0x6,4)
   | Store_AMO_Fault => BitsN.B(0x7,4)
   | UMode_Env_Call => BitsN.B(0x8,4)
   | SMode_Env_Call => BitsN.B(0x9,4)
   | MMode_Env_Call => BitsN.B(0xB,4)
   | Fetch_PageFault => BitsN.B(0xC,4)
   | Load_PageFault => BitsN.B(0xD,4)
   | Store_AMO_PageFault => BitsN.B(0xF,4);

fun excName e =
  case e of
     Fetch_Misaligned => "MISALIGNED_FETCH"
   | Fetch_Fault => "FAULT_FETCH"
   | Illegal_Instr => "ILLEGAL_INSTRUCTION"
   | Breakpoint => "BREAKPOINT"
   | Load_Misaligned => "MISALIGNED_LOAD"
   | Load_Fault => "FAULT_LOAD"
   | Store_AMO_Misaligned => "MISALIGNED_STORE_AMO"
   | Store_AMO_Fault => "FAULT_STORE_AMO"
   | UMode_Env_Call => "U-EnvCall"
   | SMode_Env_Call => "S-EnvCall"
   | MMode_Env_Call => "M-EnvCall"
   | Fetch_PageFault => "PAGEFAULT_FETCH"
   | Load_PageFault => "PAGEFAULT_LOAD"
   | Store_AMO_PageFault => "PAGEFAULT_STORE_AMO";

fun rec'misa x =
  {A = BitsN.bit(x,0), C = BitsN.bit(x,2), D = BitsN.bit(x,3),
   F = BitsN.bit(x,5), I = BitsN.bit(x,8), M = BitsN.bit(x,12),
   MXL = BitsN.bits(63,62) x, S = BitsN.bit(x,18), U = BitsN.bit(x,20),
   misa'rst =
     BitsN.concat
       [BitsN.bits(1,1) x,BitsN.bits(4,4) x,BitsN.bits(7,6) x,
        BitsN.bits(11,9) x,BitsN.bits(17,13) x,BitsN.bits(19,19) x,
        BitsN.bits(61,21) x]};

fun reg'misa x =
  case x of
     {A = A, C = C, D = D, F = F, I = I, M = M, MXL = MXL, S = S, U = U,
      misa'rst = misa'rst} =>
       BitsN.concat
         [MXL,BitsN.bits(40,0) misa'rst,BitsN.fromBit U,
          BitsN.bits(41,41) misa'rst,BitsN.fromBit S,
          BitsN.bits(46,42) misa'rst,BitsN.fromBit M,
          BitsN.bits(49,47) misa'rst,BitsN.fromBit I,
          BitsN.bits(51,50) misa'rst,BitsN.fromBit F,
          BitsN.bits(52,52) misa'rst,BitsN.fromBit D,BitsN.fromBit C,
          BitsN.bits(53,53) misa'rst,BitsN.fromBit A];

fun write'rec'misa (_,x) = reg'misa x;

fun write'reg'misa (_,x) = rec'misa x;

