fun checkCSROp (csr,(rs1,a)) =
  (is_CSR_defined csr) andalso
  ((check_CSR_access(csrRW csr,(csrPR csr,(curPrivilege (),a)))) andalso
   (check_CSR_conditions(csr,curPrivilege ())));

fun accessCSR (op',(rd,(f,(src,csr)))) =
  let
    val isWrite = (op' = CSR_Write) orelse (not(f = (BitsN.B(0x0,5))))
  in
    if checkCSROp(csr,(f,if isWrite then Write else Read))
      then let
             val old = CSR csr
           in
             ( if isWrite
                 then let
                        val base =
                          if csr = (BitsN.B(0x344,12))
                            then BitsN.||
                                   (BitsN.&&
                                      (old,BitsN.~(BitsN.B(0x200,64))),
                                    BitsN.&&
                                      (reg'mip
                                         (#mip((MCSR ()) : MachineCSR)),
                                       BitsN.B(0x200,64)))
                          else old
                      in
                        writeCSR
                          (csr,
                           case op' of
                              CSR_Write => src
                            | CSR_Set => BitsN.||(base,src)
                            | CSR_Clear => BitsN.&&(base,BitsN.~ src))
                      end
               else ()
             ; let
                 val v = old
               in
                 ( write'GPR(v,rd)
                 ; let
                     val x = Delta ()
                   in
                     write'Delta(StateDelta_data1_rupd(x,Option.SOME v))
                   end
                 )
               end
             )
           end
    else signalException Illegal_Instr
  end;

