fun MEM a =
  let
    val b = BitsN.<<(BitsN.fromNat(BitsN.toNat a,64),3)
  in
    BitsN.concat
      [Map.lookup((!MEM8),BitsN.toNat(BitsN.+(b,BitsN.B(0x7,64)))),
       Map.lookup((!MEM8),BitsN.toNat(BitsN.+(b,BitsN.B(0x6,64)))),
       Map.lookup((!MEM8),BitsN.toNat(BitsN.+(b,BitsN.B(0x5,64)))),
