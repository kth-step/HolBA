  ; c_extMEIP := (Map.update((!c_extMEIP),BitsN.toNat (!procID),false))
  ; c_extSEIP := (Map.update((!c_extSEIP),BitsN.toNat (!procID),false))
  ; write'ReserveLoad NONE
  ; write'ExitCode(BitsN.B(0x0,64))
  );

fun initRegs pc =
  ( L3.for
      (0,31,
       fn i =>
         let
           val x = BitsN.fromNat(i,5)
         in
           write'gpr(BitsN.B(0x0,64),x)
         end)
  ; L3.for
      (0,31,
       fn i =>
         let
           val x = BitsN.fromNat(i,5)
         in
           write'fpr(BitsN.B(0x0,64),x)
         end)
  ; write'PC(BitsN.fromNat(pc,64))
  ; write'NextFetch NONE
  ; done := false
  );

end
