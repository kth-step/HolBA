val MISA_RESET = BitsN.B(0x800000000014112D,64)

fun legalize_misa (v,(m,pc)) =
  if (not(BitsN.bit(v,2))) andalso
     ((#C(m : misa)) andalso (BitsN.bit(pc,1)))
    then m
  else let
         val n = ref m
       in
         ( n := (misa_C_rupd((!n),BitsN.bit(v,2))); (!n) )
       end;

val MSTATUS_WMASK = BitsN.B(0x7E79AA,64)

val MSTATUS_CONST = BitsN.B(0xA00000000,64)

val MSTATUS_SD = BitsN.B(0x8000000000000000,64)

fun legalize_mstatus v =
  let
    val m = ref (rec'mstatus(BitsN.&&(v,MSTATUS_WMASK)))
  in
    ( if (#MPP((!m) : mstatus)) = (BitsN.B(0x2,2))
        then m := (mstatus_MPP_rupd((!m),BitsN.B(0x0,2)))
      else ()
    ; (!m)
    )
  end;

fun read_mstatus m =
  BitsN.||
    (BitsN.||(BitsN.&&(reg'mstatus m,MSTATUS_WMASK),MSTATUS_CONST),
     if (#FS(m : mstatus)) = (ext_status Dirty)
       then MSTATUS_SD
     else BitsN.B(0x0,64));

val SSTATUS_MASK = BitsN.B(0x80000003018DE762,64)

fun read_sstatus m = BitsN.&&(read_mstatus m,SSTATUS_MASK);

fun legalize_sstatus (v,m) =
  legalize_mstatus
    (BitsN.||
       (BitsN.&&(reg'mstatus m,BitsN.~ SSTATUS_MASK),
        BitsN.&&(v,SSTATUS_MASK)));

fun legalize_xtvec (v,old) =
  if BitsN.bit(v,1)
    then BitsN.@@(BitsN.bits(63,2) v,BitsN.bits(1,0) old)
  else v;

fun legalize_xepc v = BitsN.&&(v,BitsN.~(BitsN.B(0x1,64)));

fun legalize_mcause (v,old) =
  let
    val c = BitsN.bits(62,0) v
  in
    if if BitsN.bit(v,63)
         then (c = (BitsN.B(0x1,63))) orelse
              ((c = (BitsN.B(0x3,63))) orelse
               ((c = (BitsN.B(0x5,63))) orelse
                ((c = (BitsN.B(0x7,63))) orelse
                 ((c = (BitsN.B(0x9,63))) orelse (c = (BitsN.B(0xB,63)))))))
       else ((BitsN.<+(c,BitsN.B(0x10,63))) andalso
             ((not(c = (BitsN.B(0xA,63)))) andalso
              (not(c = (BitsN.B(0xE,63)))))) orelse
            (c = (BitsN.B(0x13,63)))
      then rec'mcause v
    else old
  end;

fun legalize_scause (v,old) =
  if BitsN.<=+(BitsN.bits(62,0) v,BitsN.B(0x1F,63))
    then rec'mcause v
  else legalize_mcause(v,old);

fun legalize_satp (v,old) =
  let
    val m = BitsN.&&(v,BitsN.B(0xF000000000000000,64))
  in
    if (m = (BitsN.B(0x0,64))) orelse
       ((m = (BitsN.B(0x8000000000000000,64))) orelse
        ((m = (BitsN.B(0x9000000000000000,64))) orelse
         (m = (BitsN.B(0xA000000000000000,64)))))
      then v
    else old
  end;

fun rec'pmpcfg x =
  {A = BitsN.bits(4,3) x, L = BitsN.bit(x,7), R = BitsN.bit(x,0),
   W = BitsN.bit(x,1), X = BitsN.bit(x,2), pmpcfg'rst = BitsN.bits(6,5) x};

fun reg'pmpcfg x =
  case x of
     {A = A, L = L, R = R, W = W, X = X, pmpcfg'rst = pmpcfg'rst} =>
       BitsN.concat
         [BitsN.fromBit L,pmpcfg'rst,A,BitsN.fromBit X,BitsN.fromBit W,
          BitsN.fromBit R];

fun write'rec'pmpcfg (_,x) = reg'pmpcfg x;

fun write'reg'pmpcfg (_,x) = rec'pmpcfg x;

fun legalize_pmpcfg_byte (b,old) =
  if #L(old : pmpcfg)
    then old
  else let
         val n = ref (rec'pmpcfg(BitsN.&&(b,BitsN.B(0x9F,8))))
       in
         ( if (not(#R((!n) : pmpcfg))) andalso (#W((!n) : pmpcfg))
             then ( n := (pmpcfg_W_rupd((!n),false))
                  ; n := (pmpcfg_X_rupd((!n),false))
                  )
           else ()
         ; (!n)
         )
       end;

fun legalize_pmpcfg (v,old) =
  BitsN.concat
    [reg'pmpcfg
       (legalize_pmpcfg_byte
          (BitsN.bits(63,56) v,rec'pmpcfg(BitsN.bits(63,56) old))),
     reg'pmpcfg
       (legalize_pmpcfg_byte
          (BitsN.bits(55,48) v,rec'pmpcfg(BitsN.bits(55,48) old))),
     reg'pmpcfg
       (legalize_pmpcfg_byte
          (BitsN.bits(47,40) v,rec'pmpcfg(BitsN.bits(47,40) old))),
     reg'pmpcfg
       (legalize_pmpcfg_byte
          (BitsN.bits(39,32) v,rec'pmpcfg(BitsN.bits(39,32) old))),
     reg'pmpcfg
       (legalize_pmpcfg_byte
          (BitsN.bits(31,24) v,rec'pmpcfg(BitsN.bits(31,24) old))),
     reg'pmpcfg
       (legalize_pmpcfg_byte
          (BitsN.bits(23,16) v,rec'pmpcfg(BitsN.bits(23,16) old))),
     reg'pmpcfg
       (legalize_pmpcfg_byte
          (BitsN.bits(15,8) v,rec'pmpcfg(BitsN.bits(15,8) old))),
     reg'pmpcfg
       (legalize_pmpcfg_byte
          (BitsN.bits(7,0) v,rec'pmpcfg(BitsN.bits(7,0) old)))];

