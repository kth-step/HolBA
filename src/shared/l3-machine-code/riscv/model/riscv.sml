fun pmpPermits (cfg,kind) =
  case kind of
     PMP_Read => #R(cfg : pmpcfg)
   | PMP_Write => #W(cfg : pmpcfg)
   | PMP_ReadWrite => (#R(cfg : pmpcfg)) andalso (#W(cfg : pmpcfg))
   | PMP_Execute => #X(cfg : pmpcfg);

fun pmpRegion i =
  let
    val y = pmpaddr i
  in
    case #A((pmpcfg_ent i) : pmpcfg) of
       BitsN.B(0x0,_) => NONE
     | BitsN.B(0x1,_) =>
       let
         val lo =
           if i = (BitsN.B(0x0,4))
             then BitsN.B(0x0,64)
           else BitsN.<<(pmpaddr(BitsN.-(i,BitsN.B(0x1,4))),2)
         val hi = BitsN.<<(y,2)
       in
         if BitsN.<+(lo,hi) then Option.SOME(lo,hi) else NONE
       end
     | BitsN.B(0x2,_) =>
       Option.SOME(BitsN.<<(y,2),BitsN.+(BitsN.<<(y,2),BitsN.B(0x4,64)))
     | BitsN.B(0x3,_) =>
       let
         val m = BitsN.??(y,BitsN.+(y,BitsN.B(0x1,64)))
         val lo = BitsN.<<(BitsN.&&(y,BitsN.~ m),2)
       in
         Option.SOME
           (lo,BitsN.+(lo,BitsN.<<(BitsN.+(m,BitsN.B(0x1,64)),2)))
       end
     | _ => raise General.Bind
  end;

fun pmpEntryCheck (i,(a,(last,(kind,p)))) =
  case pmpRegion i of
     NONE => NONE
   | Option.SOME(lo,hi) =>
     (if (BitsN.<+(last,lo)) orelse (BitsN.<=+(hi,a))
        then NONE
      else if (BitsN.<=+(lo,a)) andalso (BitsN.<+(last,hi))
        then let
               val cfg = pmpcfg_ent i
             in
               Option.SOME
                 (((p = Machine) andalso (not(#L(cfg : pmpcfg)))) orelse
                  (pmpPermits(cfg,kind)))
             end
      else Option.SOME false);

fun pmpCheck (a,(n,(kind,p))) =
  let
    val last = BitsN.+(a,BitsN.fromNat(Nat.-(n,1),64))
    val e0 = pmpEntryCheck(BitsN.B(0x0,4),(a,(last,(kind,p))))
    val e1 = pmpEntryCheck(BitsN.B(0x1,4),(a,(last,(kind,p))))
    val e2 = pmpEntryCheck(BitsN.B(0x2,4),(a,(last,(kind,p))))
    val e3 = pmpEntryCheck(BitsN.B(0x3,4),(a,(last,(kind,p))))
    val e4 = pmpEntryCheck(BitsN.B(0x4,4),(a,(last,(kind,p))))
    val e5 = pmpEntryCheck(BitsN.B(0x5,4),(a,(last,(kind,p))))
    val e6 = pmpEntryCheck(BitsN.B(0x6,4),(a,(last,(kind,p))))
    val e7 = pmpEntryCheck(BitsN.B(0x7,4),(a,(last,(kind,p))))
    val e8 = pmpEntryCheck(BitsN.B(0x8,4),(a,(last,(kind,p))))
    val e9 = pmpEntryCheck(BitsN.B(0x9,4),(a,(last,(kind,p))))
    val e10 = pmpEntryCheck(BitsN.B(0xA,4),(a,(last,(kind,p))))
    val e11 = pmpEntryCheck(BitsN.B(0xB,4),(a,(last,(kind,p))))
    val e12 = pmpEntryCheck(BitsN.B(0xC,4),(a,(last,(kind,p))))
    val e13 = pmpEntryCheck(BitsN.B(0xD,4),(a,(last,(kind,p))))
    val e14 = pmpEntryCheck(BitsN.B(0xE,4),(a,(last,(kind,p))))
    val e15 = pmpEntryCheck(BitsN.B(0xF,4),(a,(last,(kind,p))))
  in
    if Option.isSome e0
      then Option.valOf e0
    else if Option.isSome e1
      then Option.valOf e1
    else if Option.isSome e2
      then Option.valOf e2
    else if Option.isSome e3
      then Option.valOf e3
    else if Option.isSome e4
      then Option.valOf e4
    else if Option.isSome e5
      then Option.valOf e5
    else if Option.isSome e6
      then Option.valOf e6
    else if Option.isSome e7
      then Option.valOf e7
    else if Option.isSome e8
      then Option.valOf e8
    else if Option.isSome e9
      then Option.valOf e9
    else if Option.isSome e10
      then Option.valOf e10
    else if Option.isSome e11
      then Option.valOf e11
    else if Option.isSome e12
      then Option.valOf e12
    else if Option.isSome e13
      then Option.valOf e13
    else if Option.isSome e14
      then Option.valOf e14
    else if Option.isSome e15 then Option.valOf e15 else p = Machine
  end;

fun pageFault (ft,ac) =
  if ft = Instruction
    then Fetch_PageFault
  else if ac = Read then Load_PageFault else Store_AMO_PageFault;

fun accessFault (ft,ac) =
  if ft = Instruction
    then Fetch_Fault
  else if ac = Read then Load_Fault else Store_AMO_Fault;

fun ptePermits (pte,(ft,(ac,p))) =
  let
    val store = (ft = Data) andalso (ac = Write)
    val uOK =
      if p = User
        then BitsN.bit(pte,4)
      else (not(BitsN.bit(pte,4))) orelse
           ((ft = Data) andalso
            (#SUM((#mstatus((MCSR ()) : MachineCSR)) : mstatus)))
    val xwrOK =
      if ft = Instruction
        then BitsN.bit(pte,3)
      else if ac = Read
        then (BitsN.bit(pte,1)) orelse
             ((BitsN.bit(pte,3)) andalso
              (#MXR((#mstatus((MCSR ()) : MachineCSR)) : mstatus)))
      else BitsN.bit(pte,2)
    val adOK =
      (BitsN.bit(pte,6)) andalso ((not store) orelse (BitsN.bit(pte,7)))
  in
    uOK andalso (xwrOK andalso adOK)
  end;

fun ptwLevel (i,(ppn,(va,(ft,(ac,p))))) =
  let
    val pteAddr =
      BitsN.+
        (BitsN.<<(BitsN.zeroExtend 64 ppn,12),
         BitsN.<<
           (BitsN.&&(BitsN.>>+(va,Nat.+(12,Nat.*(9,i))),BitsN.B(0x1FF,64)),
            3))
  in
    if not(pmpCheck(pteAddr,(8,(PMP_Read,Supervisor))))
      then W_AccessFault
    else let
           val pte = MEM(BitsN.bits(63,3) pteAddr)
           val leaf = (BitsN.bit(pte,1)) orelse (BitsN.bit(pte,3))
         in
           if (not(BitsN.bit(pte,0))) orelse
              (((BitsN.bit(pte,2)) andalso (not(BitsN.bit(pte,1)))) orelse
               ((not((BitsN.&&(pte,BitsN.B(0xFFC0000000000000,64))) =
                     (BitsN.B(0x0,64)))) orelse
                ((not leaf) andalso
                 (not((BitsN.&&(pte,BitsN.B(0xD0,64))) = (BitsN.B(0x0,64)))))))
             then W_PageFault
           else if not leaf
             then if i = 0
                    then W_PageFault
                  else W_Next(BitsN.bits(53,10) pte)
           else let
                  val base =
                    BitsN.<<
                      (BitsN.zeroExtend 64 (BitsN.bits(53,10) pte),12)
                  val mask =
                    BitsN.-
                      (BitsN.<<(BitsN.B(0x1,64),Nat.+(12,Nat.*(9,i))),
                       BitsN.B(0x1,64))
                in
                  if not((BitsN.&&(base,mask)) = (BitsN.B(0x0,64)))
                    then W_PageFault
                  else if not(ptePermits(pte,(ft,(ac,p))))
                    then W_PageFault
                  else W_Address(BitsN.||(base,BitsN.&&(va,mask)))
                end
         end
  end;

fun ptwStep (r,(i,(levels,(va,(ft,(ac,p)))))) =
  case r of
     W_Next ppn =>
       (if Nat.<(i,levels) then ptwLevel(i,(ppn,(va,(ft,(ac,p))))) else r)
   | _ => r;

fun translateAddr (va,(ft,(ac,p))) =
  if p = Machine
    then TR_Address va
  else let
         val satp = #satp((SCSR ()) : SupervisorCSR)
         val levels =
           case BitsN.bits(63,60) satp of
              BitsN.B(0x8,_) => 3
            | BitsN.B(0x9,_) => 4
            | BitsN.B(0xA,_) => 5
            | _ => 0
       in
         if levels = 0
           then TR_Address va
         else let
                val sh = Nat.-(64,Nat.+(12,Nat.*(9,levels)))
              in
                if not((BitsN.>>(BitsN.<<(va,sh),sh)) = va)
                  then TR_Fault(pageFault(ft,ac))
                else let
                       val r4 =
                         ptwStep
                           (W_Next(BitsN.bits(43,0) satp),
                            (4,(levels,(va,(ft,(ac,p))))))
                       val r3 = ptwStep(r4,(3,(levels,(va,(ft,(ac,p))))))
                       val r2 = ptwStep(r3,(2,(levels,(va,(ft,(ac,p))))))
                       val r1 = ptwStep(r2,(1,(levels,(va,(ft,(ac,p))))))
                       val r0 = ptwStep(r1,(0,(levels,(va,(ft,(ac,p))))))
                     in
                       case r0 of
                          W_Address pa => TR_Address pa
                        | W_AccessFault => TR_Fault(accessFault(ft,ac))
                        | _ => TR_Fault(pageFault(ft,ac))
                     end
              end
       end;

fun fetchAddr vAddr =
  let
    val p = curPrivilege ()
  in
    case translateAddr(vAddr,(Instruction,(Read,p))) of
       TR_Address pAddr =>
         (if pmpCheck(pAddr,(2,(PMP_Execute,p)))
            then TR_Address pAddr
          else TR_Fault Fetch_Fault)
     | f => f
  end;

fun dataAddr (vAddr,(n,kind)) =
  let
    val p = effectivePrivilege ()
    val ac = if kind = PMP_Read then Read else Write
  in
    case translateAddr(vAddr,(Data,(ac,p))) of
       TR_Address pAddr =>
         (if pmpCheck(pAddr,(n,(kind,p)))
            then TR_Address pAddr
          else TR_Fault(accessFault(Data,ac)))
     | f => f
  end;

