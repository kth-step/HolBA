fun Fetch () =
  let
    val vPC = PC ()
  in
    if (BitsN.bit(vPC,0)) orelse
       ((BitsN.bit(vPC,1)) andalso (not(haveRVC ())))
      then F_Error(Internal(FETCH_MISALIGNED vPC))
    else case fetchAddr vPC of
            TR_Address pPC =>
              (case rawReadInst pPC of
                  Half h =>
                    ( ( let
                          val x = Delta ()
                        in
                          write'Delta(StateDelta_exc_taken_rupd(x,false))
                        end
                      ; let
                          val x = Delta ()
                        in
                          write'Delta(StateDelta_fetch_exc_rupd(x,false))
                        end
                      ; let
                          val x = Delta ()
                        in
                          write'Delta(StateDelta_pc_rupd(x,vPC))
                        end
                      ; let
                          val x = Delta ()
                        in
                          write'Delta(StateDelta_rinstr_rupd(x,Half h))
                        end
                      ; let
                          val x = Delta ()
                        in
                          write'Delta(StateDelta_addr_rupd(x,NONE))
                        end
                      ; let
                          val x = Delta ()
                        in
                          write'Delta(StateDelta_data1_rupd(x,NONE))
                        end
                      ; let
                          val x = Delta ()
                        in
                          write'Delta(StateDelta_data2_rupd(x,NONE))
                        end
                      ; let
                          val x = Delta ()
                        in
                          write'Delta(StateDelta_fp_data_rupd(x,NONE))
                        end
                      ; let
                          val x = Delta ()
                        in
                          write'Delta(StateDelta_st_width_rupd(x,NONE))
                        end
                      )
                    ; F_Result(Half h)
                    )
                | Word w =>
                  (case fetchAddr(BitsN.+(vPC,BitsN.B(0x2,64))) of
                      TR_Address pPC2 =>
                        let
                          val instw =
                            Word
                              (BitsN.concat
                                 [Map.lookup
                                    ((!MEM8),
                                     BitsN.toNat
                                       (BitsN.+(pPC2,BitsN.B(0x1,64)))),
                                  Map.lookup((!MEM8),BitsN.toNat pPC2),
                                  BitsN.bits(15,0) w])
                        in
                          ( ( let
                                val x = Delta ()
                              in
                                write'Delta
                                  (StateDelta_exc_taken_rupd(x,false))
                              end
                            ; let
                                val x = Delta ()
                              in
                                write'Delta
                                  (StateDelta_fetch_exc_rupd(x,false))
                              end
                            ; let
                                val x = Delta ()
                              in
                                write'Delta(StateDelta_pc_rupd(x,vPC))
                              end
                            ; let
                                val x = Delta ()
                              in
                                write'Delta
                                  (StateDelta_rinstr_rupd(x,instw))
                              end
                            ; let
                                val x = Delta ()
                              in
                                write'Delta(StateDelta_addr_rupd(x,NONE))
                              end
                            ; let
                                val x = Delta ()
                              in
                                write'Delta(StateDelta_data1_rupd(x,NONE))
                              end
                            ; let
                                val x = Delta ()
                              in
                                write'Delta(StateDelta_data2_rupd(x,NONE))
                              end
                            ; let
                                val x = Delta ()
                              in
                                write'Delta
                                  (StateDelta_fp_data_rupd(x,NONE))
                              end
                            ; let
                                val x = Delta ()
                              in
                                write'Delta
                                  (StateDelta_st_width_rupd(x,NONE))
                              end
                            )
                          ; F_Result instw
                          )
                        end
                    | TR_Fault e =>
                      F_Error
                        (Internal
                           (FETCH_FAULT(e,BitsN.+(vPC,BitsN.B(0x2,64)))))))
          | TR_Fault e => F_Error(Internal(FETCH_FAULT(e,vPC)))
  end;

