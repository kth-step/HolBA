fun log_instruction (w,inst) =
  String.concat
    ["instr ",BitsN.toHexString (!procID)," ",
     Nat.toString
       (BitsN.toNat(Map.lookup((!c_instret),BitsN.toNat (!procID)))),
     " 0x",hex64(PC ())," : ",hex32 w,"   ",instructionToString inst];

fun exitCode () = BitsN.toNat(ExitCode ());

fun incrInstret incIR =
  if incIR andalso
     (not(Map.lookup((!c_minstret_written),BitsN.toNat (!procID))))
    then c_instret :=
         (Map.update
            ((!c_instret),BitsN.toNat (!procID),
             BitsN.+
               (Map.lookup((!c_instret),BitsN.toNat (!procID)),
                BitsN.B(0x1,64))))
  else ();

fun fetchAndExecute () =
  case Fetch () of
     F_Result(Half h) =>
       let
         val inst = if haveRVC () then DecodeRVC h else UnknownInstruction
       in
         ( log :=
           ((1,log_instruction(BitsN.zeroExtend 32 h,inst)) :: (!log))
         ; Run inst
         ; BitsN.zeroExtend 64 h
         )
       end
   | F_Result(Word w) =>
     let
       val inst = Decode w
     in
       ( log := ((1,log_instruction(w,inst)) :: (!log))
       ; Run inst
       ; BitsN.zeroExtend 64 w
       )
     end
   | F_Error inst =>
     ( log := ((1,log_instruction(BitsN.B(0x0,32),inst)) :: (!log))
     ; Run inst
     ; BitsN.B(0x0,64)
     );

fun Next () =
  ( clear_logs ()
  ; c_minstret_written :=
    (Map.update((!c_minstret_written),BitsN.toNat (!procID),false))
  ; let
      val incIR = not(BitsN.bit(#mcountinhibit((MCSR ()) : MachineCSR),2))
    in
      ( case checkInterrupts () of
           Option.SOME(i,p) =>
             takeTrap(true,(interruptIndex i,(PC (),(BitsN.B(0x0,64),p))))
         | NONE =>
           let
             val ibits = fetchAndExecute ()
           in
             case NextFetch () of
                NONE =>
                  ( incrInstret incIR; write'PC(BitsN.+(PC (),Skip ())) )
              | Option.SOME(BranchTo addr) =>
                ( incrInstret incIR; write'NextFetch NONE; write'PC addr )
              | Option.SOME Mret =>
                ( incrInstret incIR; write'NextFetch NONE; mret () )
              | Option.SOME Sret =>
                ( incrInstret incIR; write'NextFetch NONE; sret () )
              | Option.SOME(Trap t) =>
                ( write'NextFetch NONE
                ; let
                    val ec = excCode(#trap(t : SynchronousTrap))
                    val tval =
                      if (#trap(t : SynchronousTrap)) = Illegal_Instr
                        then ibits
                      else #tval(t : SynchronousTrap)
                  in
                    takeTrap
                      (false,
                       (ec,(PC (),(tval,excDest(ec,curPrivilege ())))))
                  end
                )
           end
      ; if not(BitsN.bit(#mcountinhibit((MCSR ()) : MachineCSR),0))
          then c_cycles :=
               (Map.update
                  ((!c_cycles),BitsN.toNat (!procID),
                   BitsN.+
                     (Map.lookup((!c_cycles),BitsN.toNat (!procID)),
                      BitsN.B(0x1,64))))
        else ()
      )
    end
  );

fun initIdent arch =
  ( if not(arch = RV64I)
      then raise UNDEFINED "only RV64I is implemented"
    else ()
  ; let
      val x = MCSR ()
    in
      write'MCSR(MachineCSR_misa_rupd(x,rec'misa MISA_RESET))
    end
  );

